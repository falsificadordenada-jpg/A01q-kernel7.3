# Config fragment: Galaxy A01 (a01q) touchscreen and Wi-Fi/Bluetooth.
# Apply on top of the board's defconfig:
#   make ARCH=arm64 <your_defconfig> a01q-touch-wifi.config

# Focaltech touchscreen (I2C 0x38 on blsp1_i2c3). Built in so the screen
# works as soon as the kernel is up.
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y

# WCNSS (Pronto) transport, needed by the Wi-Fi/Bluetooth firmware.
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMSM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_WCNSS_CTRL=y
CONFIG_QCOM_RPMPD=y

# WCNSS remoteproc, Wi-Fi and Bluetooth are modules on purpose: they ask for
# firmware (wcnss.mdt, nv bin), so load them once the firmware is readable.
# cfg80211/mac80211 are modules too, because RFKILL is a module in defconfig.
CONFIG_QCOM_WCNSS_PIL=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WCN36XX=m
CONFIG_BT=m
CONFIG_BT_QCOMSMD=m
