# Samsung Galaxy A01 (a01q, MSM8937/SDM439) config fragment.
#
# Usage (on top of the generic arm64 defconfig):
#   make ARCH=arm64 defconfig a01q.config a01q-touch-wifi.config
#
# Touchscreen and Wi-Fi options live in a01q-touch-wifi.config (apply after this one).

# ---- Local version -------------------------------------------------------
CONFIG_LOCALVERSION="-a01q"

# ---- Performance-oriented build (4x Cortex-A53, 2 GB RAM or less) --------
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_PREEMPT_NONE=n
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_HZ_250=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZSWAP=n
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_TRANSPARENT_HUGEPAGE=n
CONFIG_KSM=n
CONFIG_NUMA=n
CONFIG_NUMA_BALANCING=n
CONFIG_KVM=n
CONFIG_XEN=n
CONFIG_VIRTUALIZATION=n
CONFIG_KPROBES=n
CONFIG_PROFILING=n
CONFIG_PM_ADVANCED_DEBUG=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_DEBUG_INFO_DWARF5=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_RANDOMIZE_BASE=n
CONFIG_ARM64_SW_TTBR0_PAN=n
# Cortex-A53 has no 52-bit VA (LPA2); use 48 bits.
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_VA_BITS_52=n
CONFIG_STACKPROTECTOR_STRONG=n
CONFIG_STACKPROTECTOR=n

# ---- SoC / board ---------------------------------------------------------
CONFIG_ARCH_QCOM=y
CONFIG_MSM_GCC_8917=y
CONFIG_PINCTRL_MSM8917=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_QCOM_RPMPD=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_INTERCONNECT_QCOM_MSM8937=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMSM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_QCOM_RPM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_VADC=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_EVDEV=y

# ---- Display / console (bootloader-initialized framebuffer) --------------
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DRM_CLIENT_DEFAULT_FBDEV=y
# Large font so the kernel log is readable on the 720x1520 panel.
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y

# ---- Debugging that survives a crash -------------------------------------
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# ---- Modules: allow loading externally built modules ---------------------
# Modules must still be built against this exact tree and configuration.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=n
CONFIG_MODULE_SIG=n
CONFIG_MODULE_FORCE_LOAD=y

# ---- Android userspace requirements --------------------------------------
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_AUDIT=y
CONFIG_PSI=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_MEMCG=y
CONFIG_MEMCG_V1=y
CONFIG_BLK_CGROUP=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CPUSETS_V1=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_USER_NS=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""
CONFIG_CMA=y
CONFIG_USERFAULTFD=y
CONFIG_SECCOMP=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_LSM="landlock,lockdown,yama,selinux,bpf"
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_EROFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_VERITY=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_UEVENT=y
CONFIG_TUN=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_QUOTA=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_INET_UDP_DIAG=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_BPF=y
CONFIG_ANDROID_USB_CONFIGFS_UEVENT=y

# ---- Not needed on this board --------------------------------------------
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
CONFIG_SOUND=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_CAN=n
